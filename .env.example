# Copy to .env.local (dev) or ~/counter/.env (server). Never commit real values.

# --- Database ---
# Local dev: full URL. On the server compose builds DATABASE_URL from POSTGRES_PASSWORD.
DATABASE_URL=postgres://counter:counter@localhost:5432/counter
POSTGRES_PASSWORD=change-me

# --- App ---
APP_URL=http://localhost:3000
SESSION_SECRET=change-me-32-bytes-min

# --- LLM (Anthropic) ---
ANTHROPIC_API_KEY=
LLM_MODEL_FAST=claude-haiku-5-5
LLM_MODEL_MAIN=claude-sonnet-5-5
# Hard stop for LLM spend per UTC day, in USD (estimated from token usage).
LLM_DAILY_BUDGET_USD=15

# --- Voice (ElevenLabs) ---
ELEVENLABS_API_KEY=

# --- Payments (Polar sandbox) ---
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_SERVER=sandbox
POLAR_PRODUCT_PASS=
POLAR_PRODUCT_MEMBERSHIP=

# --- Server only ---
PROXY_NETWORK=nice-almaty_default
